{
	"schemaVersion": 1,
	"id": "fishingrodfix",
	"version": "${version}",
	"name": "Fishing rod fix",
	"description": "Fixes the fishing line so it starts at the rod tip, in first person and on every player's body in third person, and hides the line of a hook whose rod was put away.",
	"authors": [
		"andrewchik"
	],
	"contact": {
		"sources": "https://github.com/andrewchik0/fishing-rod-fix"
	},
	"license": "MIT",
	"icon": "assets/fishingrodfix/icon.png",
	"environment": "client",
	"mixins": [
		"fishingrodfix.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.14.25",
		"minecraft": ">=1.20 <=1.20.1",
		"java": ">=17"
	},
	"breaks": {
		"enchanted_fishing_line": "*"
	}
}
